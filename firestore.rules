rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any authenticated user can read and write all data.
    // Role-based access control is enforced in the app layer.
    // This is appropriate for a student/development project.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
