import 'dart:async';
import 'package:file_picker/file_picker.dart';
import 'package:firebase_storage/firebase_storage.dart';
import 'package:cloud_firestore/cloud_firestore.dart';
import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';

import '../../../controllers/auth_controller.dart';
import '../../../controllers/mentor/mentor_courses_controller.dart';
import '../../../routes/app_routes.dart';
import '../../../utils/uid_resolver.dart';

const Color _mentorTeal = Color(0xFF0E7C86);

class MentorDashboard extends StatefulWidget {
  const MentorDashboard({super.key});

  @override
  State<MentorDashboard> createState() => _MentorDashboardState();
}

class _MentorDashboardState extends State<MentorDashboard> {
  late final MentorCoursesController _ctrl;
  int _selectedIndex = 0;

  @override
  void initState() {
    super.initState();
    _ctrl = MentorCoursesController();
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (UidResolver.uid == null && mounted) {
        context.go(AppRoutes.login);
      }
    });
  }

  Future<_Summary> _loadSummary(String uid) async {
    final userDoc = await FirebaseFirestore.instance
        .collection('users')
        .doc(uid)
        .get();
    final name = (userDoc.data()?['name'] as String?)?.trim().isNotEmpty == true
        ? (userDoc.data()!['name'] as String).trim()
        : 'Mentor';
    final courseSnap = await FirebaseFirestore.instance
        .collection('courses')
        .where('mentorId', isEqualTo: uid)
        .get();
    final ids = courseSnap.docs.map((d) => d.id).toList();
    if (ids.isEmpty) {
      return _Summary(name: name, courses: 0, students: 0, rating: 0.0);
    }
    final studentIds = <String>{};
    final ratings = <double>[];
    for (var i = 0; i < ids.length; i += 10) {
      final chunk = ids.skip(i).take(10).toList();
      final enroll = await FirebaseFirestore.instance
          .collection('enrollments')
          .where('courseId', whereIn: chunk)
          .get();
      for (final d in enroll.docs) {
        final sid = (d.data()['studentId'] as String?)?.trim() ?? '';
        if (sid.isNotEmpty) studentIds.add(sid);
      }
      final reviews = await FirebaseFirestore.instance
          .collection('reviews')
          .where('courseId', whereIn: chunk)
          .get();
      for (final d in reviews.docs) {
        final r = (d.data()['rating'] as num?)?.toDouble();
        if (r != null) ratings.add(r);
      }
    }
    final avg = ratings.isEmpty
        ? 0.0
        : ratings.reduce((a, b) => a + b) / ratings.length;
    return _Summary(
      name: name,
      courses: ids.length,
      students: studentIds.length,
      rating: avg,
    );
  }

  Future<void> _deleteCourse(String courseId, String title) async {
    final ok = await showDialog<bool>(
      context: context,
      builder: (c) => AlertDialog(
        title: const Text('Delete Course?'),
        content: const Text('Delete this course? This cannot be undone.'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(c, false),
            child: const Text('Cancel'),
          ),
          FilledButton(
            style: FilledButton.styleFrom(backgroundColor: Colors.red),
            onPressed: () => Navigator.pop(c, true),
            child: const Text('Delete'),
          ),
        ],
      ),
    );
    if (ok != true) return;
    try {
      await _ctrl.deleteCourse(courseId);
      if (!mounted) return;
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(const SnackBar(content: Text('Course deleted')));
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('Error: $e')));
    }
  }

  Future<void> _togglePublish(String courseId, bool publish) async {
    await _ctrl.togglePublish(courseId, publish);
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(content: Text(publish ? 'Published' : 'Unpublished')),
    );
  }

  Widget _buildBody(String uid) {
    switch (_selectedIndex) {
      case 0:
        return _OverviewTab(uid: uid, loadSummary: _loadSummary);
      case 1:
        return _CoursesTab(
          uid: uid,
          onDelete: _deleteCourse,
          onTogglePublish: _togglePublish,
          onEdit: (data) => context.push(AppRoutes.mentorCreate, extra: data),
        );
      default:
        return _OverviewTab(uid: uid, loadSummary: _loadSummary);
    }
  }

  @override
  Widget build(BuildContext context) {
    final uid = UidResolver.uid;
    if (uid == null) {
      return const Scaffold(body: Center(child: Text('Please login')));
    }

    return FutureBuilder<_Summary>(
      future: _loadSummary(uid),
      builder: (context, snap) {
        final summary =
            snap.data ??
            const _Summary(
              name: 'Mentor',
              courses: 0,
              students: 0,
              rating: 0.0,
            );

        return Scaffold(
          backgroundColor: const Color(0xFFF4F9FA),
          appBar: AppBar(
            backgroundColor: Colors.white,
            elevation: 0,
            scrolledUnderElevation: 0.5,
            toolbarHeight: 76,
            title: Row(
              children: [
                CircleAvatar(
                  radius: 22,
                  backgroundColor: _mentorTeal.withValues(alpha: 0.15),
                  child: Text(
                    summary.name.isNotEmpty
                        ? summary.name[0].toUpperCase()
                        : 'M',
                    style: const TextStyle(
                      color: _mentorTeal,
                      fontWeight: FontWeight.w800,
                      fontSize: 18,
                    ),
                  ),
                ),
                const SizedBox(width: 14),
                Expanded(
                  child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      const Text(
                        'Good morning 👋',
                        style: TextStyle(
                          fontSize: 11,
                          color: Color(0xFF52616B),
                          fontWeight: FontWeight.w500,
                        ),
                      ),
                      const SizedBox(height: 2),
                      Text(
                        summary.name,
                        style: const TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.w800,
                          color: Color(0xFF102A43),
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),
            actions: [
              IconButton(
                icon: const Icon(
                  Icons.notifications_none_rounded,
                  color: _mentorTeal,
                  size: 24,
                ),
                onPressed: () => context.push(AppRoutes.mentorNotifications),
              ),
              Padding(
                padding: const EdgeInsets.only(right: 12),
                child: GestureDetector(
                  onTap: () => context.push(AppRoutes.mentorProfile),
                  child: CircleAvatar(
                    radius: 18,
                    backgroundColor: _mentorTeal.withValues(alpha: 0.12),
                    child: const Icon(
                      Icons.person_rounded,
                      color: _mentorTeal,
                      size: 20,
                    ),
                  ),
                ),
              ),
            ],
          ),
          body: _buildBody(uid),
          floatingActionButton: _selectedIndex == 1
              ? FloatingActionButton.extended(
                  backgroundColor: _mentorTeal,
                  foregroundColor: Colors.white,
                  onPressed: () => context.push(AppRoutes.mentorCreate),
                  icon: const Icon(Icons.add_rounded),
                  label: const Text('New Course'),
                )
              : null,
          bottomNavigationBar: NavigationBar(
            selectedIndex: _selectedIndex,
            onDestinationSelected: (index) {
              if (index == 2) {
                context.push(AppRoutes.mentorStudents);
                return;
              }
              if (index == 3) {
                context.push(AppRoutes.mentorRatings);
                return;
              }
              setState(() => _selectedIndex = index);
            },
            backgroundColor: Colors.white,
            indicatorColor: _mentorTeal.withValues(alpha: 0.15),
            destinations: const [
              NavigationDestination(
                icon: Icon(Icons.dashboard_rounded),
                selectedIcon: Icon(Icons.dashboard_rounded),
                label: 'Overview',
              ),
              NavigationDestination(
                icon: Icon(Icons.menu_book_rounded),
                selectedIcon: Icon(Icons.menu_book_rounded),
                label: 'My Courses',
              ),
              NavigationDestination(
                icon: Icon(Icons.people_rounded),
                selectedIcon: Icon(Icons.people_rounded),
                label: 'Students',
              ),
              NavigationDestination(
                icon: Icon(Icons.star_rounded),
                selectedIcon: Icon(Icons.star_rounded),
                label: 'Ratings',
              ),
            ],
          ),
        );
      },
    );
  }
}

// ─── Overview ────────────────────────────────────────────────────────────────

class _OverviewTab extends StatelessWidget {
  final String uid;
  final Future<_Summary> Function(String) loadSummary;
  const _OverviewTab({required this.uid, required this.loadSummary});

  Future<int> _mentorEnrollmentCount(String mentorUid) async {
    final coursesSnap = await FirebaseFirestore.instance
        .collection('courses')
        .where('mentorId', isEqualTo: mentorUid)
        .get();
    final courseIds = coursesSnap.docs.map((d) => d.id).toList();
    if (courseIds.isEmpty) {
      return 0;
    }

    var total = 0;
    for (var i = 0; i < courseIds.length; i += 30) {
      final chunk = courseIds.skip(i).take(30).toList();
      final enrollSnap = await FirebaseFirestore.instance
          .collection('enrollments')
          .where('courseId', whereIn: chunk)
          .get();
      total += enrollSnap.size;
    }

    return total;
  }

  @override
  Widget build(BuildContext context) {
    return FutureBuilder<_Summary>(
      future: loadSummary(uid),
      builder: (context, snap) {
        if (snap.connectionState == ConnectionState.waiting) {
          return const Center(child: CircularProgressIndicator());
        }
        final s =
            snap.data ??
            const _Summary(
              name: 'Mentor',
              courses: 0,
              students: 0,
              rating: 0.0,
            );
        return ListView(
          padding: EdgeInsets.zero,
          children: [
            // Gradient Hero Banner
            Container(
              decoration: const BoxDecoration(
                gradient: LinearGradient(
                  colors: [_mentorTeal, Color(0xFF17A2B8)],
                  begin: Alignment.topLeft,
                  end: Alignment.bottomRight,
                ),
              ),
              padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 24),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      Text(
                        'Welcome back 👋',
                        style: const TextStyle(
                          color: Colors.white,
                          fontSize: 22,
                          fontWeight: FontWeight.w800,
                        ),
                      ),
                    ],
                  ),
                  const SizedBox(height: 6),
                  Text(
                    s.name,
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 20,
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 20),
            // Stats Row
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16),
              child: Row(
                children: [
                  Expanded(
                    child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
                      stream: FirebaseFirestore.instance
                          .collection('courses')
                          .where('mentorId', isEqualTo: uid)
                          .snapshots(),
                      builder: (context, snap) {
                        if (snap.hasError) {
                          return const _StatCard(
                            'Courses',
                            '0',
                            Icons.menu_book_rounded,
                          );
                        }
                        if (snap.connectionState == ConnectionState.waiting) {
                          return const Center(
                            child: CircularProgressIndicator(),
                          );
                        }
                        final count = snap.data?.size ?? 0;
                        return _StatCard(
                          'Courses',
                          count.toString(),
                          Icons.menu_book_rounded,
                        );
                      },
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: FutureBuilder<int>(
                      future: _mentorEnrollmentCount(uid),
                      builder: (context, snap) {
                        if (snap.hasError) {
                          return const _StatCard(
                            'Students',
                            '0',
                            Icons.people_alt_rounded,
                          );
                        }
                        if (snap.connectionState == ConnectionState.waiting) {
                          return const Center(
                            child: CircularProgressIndicator(),
                          );
                        }
                        final count = snap.data ?? 0;
                        return _StatCard(
                          'Students',
                          count.toString(),
                          Icons.people_alt_rounded,
                        );
                      },
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
                      stream: FirebaseFirestore.instance
                          .collection('reviews')
                          .where('mentorId', isEqualTo: uid)
                          .snapshots(),
                      builder: (context, snap) {
                        if (snap.hasError) {
                          return const _StatCard(
                            'Rating',
                            '0.0',
                            Icons.star_rounded,
                          );
                        }
                        if (snap.connectionState == ConnectionState.waiting) {
                          return const Center(
                            child: CircularProgressIndicator(),
                          );
                        }
                        final docs = snap.data?.docs ?? [];
                        if (docs.isEmpty) {
                          return const _StatCard(
                            'Rating',
                            '0.0',
                            Icons.star_rounded,
                          );
                        }
                        final ratings = docs
                            .map(
                              (d) =>
                                  ((d.data()['rating'] as num?)?.toDouble() ??
                                  0.0),
                            )
                            .toList();
                        final avg = ratings.isEmpty
                            ? 0.0
                            : ratings.reduce((a, b) => a + b) / ratings.length;
                        return _StatCard(
                          'Rating',
                          avg.toStringAsFixed(1),
                          Icons.star_rounded,
                        );
                      },
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 24),
            // "My Courses" Section
            Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.spaceBetween,
                children: [
                  const Text(
                    'My Courses',
                    style: TextStyle(
                      fontSize: 16,
                      fontWeight: FontWeight.w700,
                      color: Color(0xFF102A43),
                    ),
                  ),
                  TextButton(
                    onPressed: () {
                      // Navigate to Courses tab
                      final state = context
                          .findAncestorStateOfType<_MentorDashboardState>();
                      state?.setState(() => state._selectedIndex = 1);
                    },
                    child: const Text(
                      'See All',
                      style: TextStyle(
                        color: _mentorTeal,
                        fontWeight: FontWeight.w600,
                      ),
                    ),
                  ),
                ],
              ),
            ),
            const SizedBox(height: 12),
            // Courses Horizontal ListView
            FutureBuilder<List<DocumentSnapshot<Map<String, dynamic>>>>(
              future: FirebaseFirestore.instance
                  .collection('courses')
                  .where('mentorId', isEqualTo: uid)
                  .limit(5)
                  .get()
                  .then((snap) => snap.docs),
              builder: (context, snap) {
                if (snap.connectionState == ConnectionState.waiting) {
                  return const Padding(
                    padding: EdgeInsets.symmetric(vertical: 16),
                    child: Center(child: CircularProgressIndicator()),
                  );
                }
                final docs = snap.data ?? [];
                if (docs.isEmpty) {
                  return Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 16),
                    child: Center(
                      child: Column(
                        children: [
                          const Icon(
                            Icons.school_outlined,
                            size: 48,
                            color: Colors.grey,
                          ),
                          const SizedBox(height: 12),
                          const Text(
                            'No courses yet',
                            style: TextStyle(color: Colors.grey),
                          ),
                          const SizedBox(height: 12),
                          FilledButton.icon(
                            onPressed: () =>
                                context.push(AppRoutes.mentorCreate),
                            style: FilledButton.styleFrom(
                              backgroundColor: _mentorTeal,
                            ),
                            icon: const Icon(Icons.add, size: 18),
                            label: const Text('Create Course'),
                          ),
                        ],
                      ),
                    ),
                  );
                }
                return SizedBox(
                  height: 200,
                  child: ListView.builder(
                    padding: const EdgeInsets.symmetric(horizontal: 16),
                    scrollDirection: Axis.horizontal,
                    itemCount: docs.length,
                    itemBuilder: (context, i) {
                      final doc = docs[i];
                      final d = doc.data();
                      final title = (d['title'] as String?) ?? 'Untitled';
                      final enroll = ((d['enrollmentCount'] as num?) ?? 0)
                          .toInt();
                      final published = (d['isPublished'] as bool?) ?? false;

                      return Padding(
                        padding: EdgeInsets.only(
                          right: i == docs.length - 1 ? 0 : 12,
                        ),
                        child: _CoursePreviewCard(
                          title: title,
                          enrolledCount: enroll,
                          isPublished: published,
                        ),
                      );
                    },
                  ),
                );
              },
            ),
            const SizedBox(height: 24),
          ],
        );
      },
    );
  }
}

// ─── My Courses ──────────────────────────────────────────────────────────────

class _CoursesTab extends StatefulWidget {
  final String uid;
  final Future<void> Function(String, String) onDelete;
  final Future<void> Function(String, bool) onTogglePublish;
  final void Function(Map<String, dynamic>) onEdit;

  const _CoursesTab({
    required this.uid,
    required this.onDelete,
    required this.onTogglePublish,
    required this.onEdit,
  });

  @override
  State<_CoursesTab> createState() => _CoursesTabState();
}

class _CoursesTabState extends State<_CoursesTab> {
  String _searchQuery = '';

  double _rating(Map<String, dynamic> d) {
    if (d['rating'] is num) {
      return (d['rating'] as num).toDouble();
    }
    if (d['averageRating'] is num) {
      return (d['averageRating'] as num).toDouble();
    }
    return 0.0;
  }

  @override
  Widget build(BuildContext context) {
    return StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
      stream: FirebaseFirestore.instance
          .collection('courses')
          .where('mentorId', isEqualTo: widget.uid)
          .snapshots(),
      builder: (context, snap) {
        if (snap.connectionState == ConnectionState.waiting) {
          return const Center(child: CircularProgressIndicator());
        }
        var docs = snap.data?.docs ?? [];
        docs.sort((a, b) {
          final aT =
              (a.data()['createdAt'] as Timestamp?)?.toDate() ??
              DateTime.fromMillisecondsSinceEpoch(0);
          final bT =
              (b.data()['createdAt'] as Timestamp?)?.toDate() ??
              DateTime.fromMillisecondsSinceEpoch(0);
          return bT.compareTo(aT);
        });

        // Filter by search query
        if (_searchQuery.isNotEmpty) {
          docs = docs
              .where(
                (doc) => ((doc.data()['title'] as String?) ?? '')
                    .toLowerCase()
                    .contains(_searchQuery.toLowerCase()),
              )
              .toList();
        }

        if (docs.isEmpty) {
          return Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Icon(
                  Icons.menu_book_outlined,
                  size: 64,
                  color: Colors.grey,
                ),
                const SizedBox(height: 12),
                const Text(
                  'No courses yet',
                  style: TextStyle(fontSize: 18, fontWeight: FontWeight.w700),
                ),
                const SizedBox(height: 6),
                const Text(
                  'Tap + New Course to get started.',
                  style: TextStyle(color: Colors.grey),
                ),
                const SizedBox(height: 16),
                FilledButton.icon(
                  onPressed: () => context.push(AppRoutes.mentorCreate),
                  style: FilledButton.styleFrom(backgroundColor: _mentorTeal),
                  icon: const Icon(Icons.add),
                  label: const Text('Create Course'),
                ),
              ],
            ),
          );
        }

        return Column(
          children: [
            // SearchBar
            Padding(
              padding: const EdgeInsets.all(16),
              child: SearchBar(
                hintText: 'Search courses...',
                leading: const Icon(Icons.search, color: _mentorTeal),
                onChanged: (value) {
                  setState(() => _searchQuery = value);
                },
                backgroundColor: WidgetStatePropertyAll(
                  Colors.grey.withValues(alpha: 0.06),
                ),
                side: WidgetStatePropertyAll(
                  BorderSide(color: Colors.grey.withValues(alpha: 0.2)),
                ),
              ),
            ),
            // Courses ListView
            Expanded(
              child: ListView.builder(
                padding: const EdgeInsets.symmetric(horizontal: 16),
                itemCount: docs.length,
                itemBuilder: (context, i) {
                  final doc = docs[i];
                  final d = doc.data();
                  final title = (d['title'] as String?) ?? 'Untitled';
                  final category = (d['category'] as String?) ?? '';
                  final level = (d['level'] as String?) ?? '';
                  final enroll = ((d['enrollmentCount'] as num?) ?? 0).toInt();
                  final published = (d['isPublished'] as bool?) ?? false;

                  return Dismissible(
                    key: ValueKey(doc.id),
                    direction: DismissDirection.endToStart,
                    onDismissed: (_) => widget.onDelete(doc.id, title),
                    background: Container(
                      margin: const EdgeInsets.only(bottom: 12),
                      decoration: BoxDecoration(
                        color: Colors.red.withValues(alpha: 0.1),
                        borderRadius: BorderRadius.circular(14),
                      ),
                      alignment: Alignment.centerRight,
                      padding: const EdgeInsets.only(right: 20),
                      child: const Icon(
                        Icons.delete_outline,
                        color: Colors.red,
                      ),
                    ),
                    child: Padding(
                      padding: const EdgeInsets.only(bottom: 12),
                      child: Card(
                        elevation: 0,
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(14),
                          side: BorderSide(
                            color: Colors.grey.withValues(alpha: 0.15),
                          ),
                        ),
                        child: Padding(
                          padding: const EdgeInsets.all(14),
                          child: Row(
                            children: [
                              // Thumbnail placeholder
                              Container(
                                width: 64,
                                height: 64,
                                decoration: BoxDecoration(
                                  gradient: const LinearGradient(
                                    colors: [_mentorTeal, Color(0xFF17A2B8)],
                                  ),
                                  borderRadius: BorderRadius.circular(12),
                                ),
                                child: const Icon(
                                  Icons.school_rounded,
                                  color: Colors.white,
                                  size: 28,
                                ),
                              ),
                              const SizedBox(width: 12),
                              // Content
                              Expanded(
                                child: Column(
                                  crossAxisAlignment: CrossAxisAlignment.start,
                                  children: [
                                    Text(
                                      title,
                                      style: const TextStyle(
                                        fontSize: 15,
                                        fontWeight: FontWeight.w700,
                                      ),
                                      maxLines: 1,
                                      overflow: TextOverflow.ellipsis,
                                    ),
                                    const SizedBox(height: 6),
                                    Row(
                                      children: [
                                        Chip(
                                          label: Text(
                                            category,
                                            style: const TextStyle(
                                              fontSize: 11,
                                              fontWeight: FontWeight.w500,
                                            ),
                                          ),
                                          backgroundColor: _mentorTeal
                                              .withValues(alpha: 0.1),
                                          side: BorderSide.none,
                                          padding: const EdgeInsets.symmetric(
                                            horizontal: 8,
                                            vertical: 2,
                                          ),
                                        ),
                                        const SizedBox(width: 6),
                                        Chip(
                                          label: Text(
                                            level,
                                            style: const TextStyle(
                                              fontSize: 11,
                                              fontWeight: FontWeight.w500,
                                            ),
                                          ),
                                          backgroundColor: Colors.amber
                                              .withValues(alpha: 0.1),
                                          side: BorderSide.none,
                                          padding: const EdgeInsets.symmetric(
                                            horizontal: 8,
                                            vertical: 2,
                                          ),
                                        ),
                                      ],
                                    ),
                                    const SizedBox(height: 6),
                                    Text(
                                      '$enroll student${enroll == 1 ? '' : 's'}',
                                      style: const TextStyle(
                                        color: Color(0xFF52616B),
                                        fontSize: 12,
                                      ),
                                    ),
                                  ],
                                ),
                              ),
                              const SizedBox(width: 12),
                              // Menu
                              PopupMenuButton<String>(
                                onSelected: (action) {
                                  switch (action) {
                                    case 'edit':
                                      widget.onEdit({
                                        'id': doc.id,
                                        'title': d['title'],
                                        'description': d['description'],
                                        'category': d['category'],
                                        'level': d['level'],
                                        'price': d['price'],
                                      });
                                      break;
                                    case 'publish':
                                      widget.onTogglePublish(
                                        doc.id,
                                        !published,
                                      );
                                      break;
                                    case 'delete':
                                      widget.onDelete(doc.id, title);
                                      break;
                                  }
                                },
                                itemBuilder: (BuildContext context) => [
                                  const PopupMenuItem(
