// ─── Lessons Bottom Sheet ────────────────────────────────────────────────────

class LessonsSheet extends StatefulWidget {
  final String courseId;
  final String courseTitle;
  const LessonsSheet({
    super.key,
    required this.courseId,
    required this.courseTitle,
  });

  @override
  State<LessonsSheet> createState() => _LessonsSheetState();
}

class _LessonsSheetState extends State<LessonsSheet> {
  final _titleCtrl = TextEditingController();
  final _descCtrl = TextEditingController();
  bool _saving = false;
  PlatformFile? _newLessonFile;
  double _newLessonUploadProgress = 0;
  bool _uploadingLessonFile = false;

  @override
  void dispose() {
    _titleCtrl.dispose();
    _descCtrl.dispose();
    super.dispose();
  }

  Future<PlatformFile?> _pickLessonFile() async {
    final result = await FilePicker.platform.pickFiles(
      type: FileType.custom,
      allowedExtensions: ['pdf', 'mp4', 'mov', 'avi'],
      withData: true,
    );
    if (result == null || result.files.isEmpty) return null;
    return result.files.first;
  }

  String _contentTypeForFile(String fileName) {
    final ext = fileName.split('.').last.toLowerCase();
    return ext == 'pdf' ? 'pdf' : 'video';
  }

  Future<void> _uploadLessonContent({
    required String courseId,
    required String lessonId,
    required PlatformFile file,
    required void Function(double progress) onProgress,
  }) async {
    final bytes = file.bytes;
    if (bytes == null) {
      throw StateError('Selected file has no data');
    }

    final storageRef = FirebaseStorage.instance.ref().child(
      'courses/$courseId/lessons/$lessonId/${file.name}',
    );
    final ext = file.name.split('.').last.toLowerCase();
    final metadata = SettableMetadata(
      contentType: ext == 'pdf' ? 'application/pdf' : 'video/$ext',
    );

    final uploadTask = storageRef.putData(bytes, metadata);
    uploadTask.snapshotEvents.listen((event) {
      final total = event.totalBytes;
      if (total > 0) {
        onProgress(event.bytesTransferred / total);
      }
    });
    await uploadTask;

    await FirebaseFirestore.instance
        .collection('courses')
        .doc(courseId)
        .collection('lessons')
        .doc(lessonId)
        .update({
          'contentUrl': await storageRef.getDownloadURL(),
          'contentType': _contentTypeForFile(file.name),
          'updatedAt': FieldValue.serverTimestamp(),
        });
  }

  Future<void> _addLesson() async {
    final t = _titleCtrl.text.trim();
    if (t.isEmpty) return;
    setState(() => _saving = true);
    try {
      final lessonsRef = FirebaseFirestore.instance
          .collection('courses')
          .doc(widget.courseId)
          .collection('lessons');
      final count = (await lessonsRef.count().get()).count ?? 0;
      final lessonDoc = lessonsRef.doc();
      await lessonDoc.set({
        'title': t,
        'description': _descCtrl.text.trim(),
        'order': count + 1,
        'contentUrl': '',
        'contentType': 'text',
        'createdAt': FieldValue.serverTimestamp(),
        'updatedAt': FieldValue.serverTimestamp(),
      });
      if (_newLessonFile != null) {
        setState(() {
          _uploadingLessonFile = true;
          _newLessonUploadProgress = 0;
        });
        try {
          await _uploadLessonContent(
            courseId: widget.courseId,
            lessonId: lessonDoc.id,
            file: _newLessonFile!,
            onProgress: (progress) {
              if (!mounted) return;
              setState(() => _newLessonUploadProgress = progress);
            },
          );
        } finally {
          if (mounted) setState(() => _uploadingLessonFile = false);
        }
      }
      _titleCtrl.clear();
      _descCtrl.clear();
      if (mounted) {
        setState(() {
          _newLessonFile = null;
          _newLessonUploadProgress = 0;
        });
      }
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('Error: $e')));
    } finally {
      if (mounted) setState(() => _saving = false);
    }
  }

  Future<void> _deleteLesson(String lessonId) async {
    await FirebaseFirestore.instance
        .collection('courses')
        .doc(widget.courseId)
        .collection('lessons')
        .doc(lessonId)
        .delete();
  }

  Future<void> _editLesson(
    String lessonId,
    Map<String, dynamic> lessonData,
  ) async {
    final titleCtrl = TextEditingController(
      text: (lessonData['title'] as String?) ?? '',
    );
    final descCtrl = TextEditingController(
      text: (lessonData['description'] as String?) ?? '',
    );
    PlatformFile? replacementFile;
    bool replacingFile = false;
    double replaceProgress = 0;

    try {
      final shouldSave = await showModalBottomSheet<bool>(
        context: context,
        isScrollControlled: true,
        builder: (sheetContext) {
          return StatefulBuilder(
            builder: (context, setSheetState) {
              return Padding(
                padding: EdgeInsets.only(
                  bottom: MediaQuery.of(sheetContext).viewInsets.bottom,
                ),
                child: SafeArea(
                  child: Container(
                    padding: const EdgeInsets.all(16),
                    child: Column(
                      mainAxisSize: MainAxisSize.min,
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Row(
                          children: [
                            const Expanded(
                              child: Text(
                                'Edit Lesson',
                                style: TextStyle(
                                  fontSize: 18,
                                  fontWeight: FontWeight.w700,
                                ),
                              ),
                            ),
                            IconButton(
                              onPressed: () => Navigator.of(sheetContext).pop(),
                              icon: const Icon(Icons.close),
                            ),
                          ],
                        ),
                        const SizedBox(height: 12),
                        TextField(
                          controller: titleCtrl,
                          decoration: const InputDecoration(
                            labelText: 'Lesson title',
                            border: OutlineInputBorder(),
                          ),
                        ),
                        const SizedBox(height: 12),
                        TextField(
                          controller: descCtrl,
                          maxLines: 3,
                          decoration: const InputDecoration(
                            labelText: 'Description',
                            border: OutlineInputBorder(),
                          ),
                        ),
                        const SizedBox(height: 12),
                        FilledButton.icon(
                          onPressed: replacingFile
                              ? null
                              : () async {
                                  final picked = await _pickLessonFile();
                                  if (picked == null) return;
                                  setSheetState(() {
                                    replacementFile = picked;
                                  });
                                },
                          icon: const Icon(Icons.upload_file),
                          label: Text(
                            replacementFile == null
                                ? 'Replace File'
                                : 'Selected: ${replacementFile!.name}',
                          ),
                        ),
                        if (replacementFile != null) ...[
                          const SizedBox(height: 8),
                          LinearProgressIndicator(value: replaceProgress),
                        ],
                        const SizedBox(height: 16),
                        Row(
                          children: [
                            Expanded(
                              child: OutlinedButton(
                                onPressed: () =>
                                    Navigator.of(sheetContext).pop(),
                                child: const Text('Cancel'),
                              ),
                            ),
                            const SizedBox(width: 12),
                            Expanded(
                              child: FilledButton(
                                onPressed: replacingFile
                                    ? null
                                    : () =>
                                          Navigator.of(sheetContext).pop(true),
                                child: const Text('Save Changes'),
                              ),
                            ),
                          ],
                        ),
                      ],
                    ),
                  ),
                ),
              );
            },
          );
        },
      );

      if (shouldSave != true) return;

      await FirebaseFirestore.instance
          .collection('courses')
          .doc(widget.courseId)
          .collection('lessons')
          .doc(lessonId)
          .update({
            'title': titleCtrl.text.trim(),
            'description': descCtrl.text.trim(),
            'updatedAt': FieldValue.serverTimestamp(),
          });

      if (replacementFile != null) {
        replacingFile = true;
        await _uploadLessonContent(
          courseId: widget.courseId,
          lessonId: lessonId,
          file: replacementFile!,
          onProgress: (progress) {
            replaceProgress = progress;
          },
        );
      }
    } finally {
      titleCtrl.dispose();
      descCtrl.dispose();
    }
  }

  @override
  Widget build(BuildContext context) {
    return DraggableScrollableSheet(
      initialChildSize: 0.9,
      minChildSize: 0.5,
      maxChildSize: 0.95,
      expand: false,
      builder: (context, sc) {
        return Padding(
          padding: EdgeInsets.only(
            bottom: MediaQuery.of(context).viewInsets.bottom,
          ),
          child: Column(
            children: [
              const SizedBox(height: 8),
              Container(
                width: 40,
                height: 4,
                decoration: BoxDecoration(
                  color: Colors.grey.shade300,
                  borderRadius: BorderRadius.circular(999),
                ),
              ),
              const SizedBox(height: 12),
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 16),
                child: Row(
                  children: [
                    const Icon(Icons.playlist_play, color: _mentorTeal),
                    const SizedBox(width: 8),
                    Expanded(
                      child: Text(
                        'Lessons: ${widget.courseTitle}',
                        style: const TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.w700,
                        ),
                        overflow: TextOverflow.ellipsis,
                      ),
                    ),
                  ],
                ),
              ),
              const Divider(height: 20),
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 16),
                child: Column(
                  children: [
                    TextField(
                      controller: _titleCtrl,
                      decoration: const InputDecoration(
                        labelText: 'Lesson title',
                        border: OutlineInputBorder(),
                        contentPadding: EdgeInsets.symmetric(
                          horizontal: 12,
                          vertical: 10,
                        ),
                      ),
                    ),
                    const SizedBox(height: 8),
                    TextField(
                      controller: _descCtrl,
                      decoration: const InputDecoration(
                        labelText: 'Description (optional)',
                        border: OutlineInputBorder(),
                        contentPadding: EdgeInsets.symmetric(
                          horizontal: 12,
                          vertical: 10,
                        ),
                      ),
                      maxLines: 2,
                    ),
                    const SizedBox(height: 10),
                    Row(
                      children: [
                        Expanded(
                          child: OutlinedButton.icon(
                            onPressed: _uploadingLessonFile
                                ? null
                                : () async {
                                    final picked = await _pickLessonFile();
                                    if (picked == null) return;
                                    if (!mounted) return;
                                    setState(() => _newLessonFile = picked);
                                  },
                            icon: const Icon(Icons.attach_file),
                            label: Text(
                              _newLessonFile == null
                                  ? 'Attach File'
                                  : _newLessonFile!.name,
                            ),
                          ),
                        ),
                      ],
                    ),
                    if (_newLessonFile != null) ...[
                      const SizedBox(height: 8),
                      LinearProgressIndicator(value: _newLessonUploadProgress),
                    ],
                    const SizedBox(height: 10),
                    SizedBox(
                      width: double.infinity,
                      child: FilledButton.icon(
                        onPressed: _saving ? null : _addLesson,
                        style: FilledButton.styleFrom(
                          backgroundColor: _mentorTeal,
                        ),
                        icon: _saving
                            ? const SizedBox(
                                width: 16,
                                height: 16,
                                child: CircularProgressIndicator(
                                  strokeWidth: 2,
                                  color: Colors.white,
                                ),
                              )
                            : const Icon(Icons.add),
                        label: const Text('Add Lesson'),
                      ),
                    ),
                  ],
                ),
              ),
              const Divider(height: 20),
              const Padding(
                padding: EdgeInsets.symmetric(horizontal: 16),
                child: Row(
                  children: [
                    Icon(Icons.list, size: 16, color: Colors.grey),
                    SizedBox(width: 6),
                    Text(
                      'Current Lessons',
                      style: TextStyle(
                        fontWeight: FontWeight.w600,
                        color: Colors.grey,
                      ),
                    ),
                  ],
                ),
              ),
              const SizedBox(height: 6),
              Expanded(
                child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
                  stream: FirebaseFirestore.instance
                      .collection('courses')
                      .doc(widget.courseId)
                      .collection('lessons')
                      .orderBy('order')
                      .snapshots(),
                  builder: (context, snap) {
                    if (snap.connectionState == ConnectionState.waiting) {
                      return const Center(child: CircularProgressIndicator());
                    }
                    final lessons = snap.data?.docs ?? [];
                    if (lessons.isEmpty) {
                      return const Center(
                        child: Padding(
                          padding: EdgeInsets.all(20),
                          child: Text(
                            'No lessons yet. Add one above.',
                            style: TextStyle(color: Colors.grey),
                          ),
                        ),
                      );
                    }
                    return ListView.builder(
                      controller: sc,
                      padding: const EdgeInsets.symmetric(horizontal: 16),
                      itemCount: lessons.length,
                      itemBuilder: (context, i) {
                        final d = lessons[i].data();
                        final lid = lessons[i].id;
                        final ltitle = (d['title'] as String?) ?? 'Untitled';
                        final ldesc = (d['description'] as String?) ?? '';
                        return Card(
                          margin: const EdgeInsets.only(bottom: 10),
                          child: ListTile(
                            onTap: () => _editLesson(lid, d),
                            leading: CircleAvatar(
                              backgroundColor: _mentorTeal.withValues(
                                alpha: 0.12,
                              ),
                              child: Text(
                                '${i + 1}',
                                style: const TextStyle(
                                  color: _mentorTeal,
                                  fontWeight: FontWeight.w700,
                                ),
                              ),
                            ),
                            title: Text(
                              ltitle,
                              style: const TextStyle(
                                fontWeight: FontWeight.w600,
                              ),
                            ),
                            subtitle: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              mainAxisSize: MainAxisSize.min,
                              children: [
                                if (ldesc.isNotEmpty)
                                  Text(
                                    ldesc,
                                    maxLines: 1,
                                    overflow: TextOverflow.ellipsis,
                                  ),
                                if ((d['contentUrl'] as String?)?.isNotEmpty ==
                                    true)
                                  const Padding(
                                    padding: EdgeInsets.only(top: 4),
                                    child: Text(
                                      'Content attached',
                                      style: TextStyle(
                                        color: Colors.green,
                                        fontSize: 12,
                                      ),
                                    ),
                                  ),
                              ],
                            ),
                            trailing: Wrap(
                              spacing: 0,
                              children: [
                                IconButton(
                                  icon: const Icon(
                                    Icons.edit_outlined,
                                    color: Colors.indigo,
                                  ),
                                  onPressed: () => _editLesson(lid, d),
                                ),
                                IconButton(
                                  icon: const Icon(
                                    Icons.delete_outline,
                                    color: Colors.red,
                                  ),
                                  onPressed: () => _deleteLesson(lid),
                                ),
                              ],
                            ),
                            contentPadding: const EdgeInsets.symmetric(
                              horizontal: 12,
                              vertical: 4,
                            ),
                          ),
                        );
                      },
                    );
                  },
                ),
              ),
            ],
          ),
        );
      },
    );
  }
}

class _MaterialsSheet extends StatefulWidget {
  const _MaterialsSheet({
    required this.courseId,
    required this.courseTitle,
    required this.onAddMaterial,
  });

  final String courseId;
  final String courseTitle;
  final VoidCallback onAddMaterial;

  @override
  State<_MaterialsSheet> createState() => _MaterialsSheetState();
}

class _MaterialsSheetState extends State<_MaterialsSheet> {
  Reference? _storageReferenceFor(String resourceUrl) {
    final url = resourceUrl.trim();
    if (url.isEmpty) return null;
    if (url.startsWith('gs://') ||
        url.contains('firebasestorage.googleapis.com')) {
      return FirebaseStorage.instance.refFromURL(url);
    }
    if (url.startsWith('courses/')) {
      return FirebaseStorage.instance.ref(url);
    }
    return null;
  }

  Future<void> _deleteMaterial(String materialId, String resourceUrl) async {
    try {
      final storageRef = _storageReferenceFor(resourceUrl);
      if (storageRef != null) {
        try {
          await storageRef.delete();
        } catch (storageError) {
          if (!mounted) return;
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(content: Text('Storage cleanup skipped: $storageError')),
          );
        }
      }

      await FirebaseFirestore.instance
          .collection('course_materials')
          .doc(materialId)
          .delete();

      if (!mounted) return;
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(const SnackBar(content: Text('Material deleted')));
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(
        context,
      ).showSnackBar(SnackBar(content: Text('Failed to delete material: $e')));
    }
  }

  void _openUploadScreen() {
    Navigator.of(context).pop();
    widget.onAddMaterial();
  }

  @override
  Widget build(BuildContext context) {
    return DraggableScrollableSheet(
      initialChildSize: 0.85,
      minChildSize: 0.45,
      maxChildSize: 0.95,
      expand: false,
      builder: (context, sc) {
        return SafeArea(
          child: Column(
            children: [
              const SizedBox(height: 8),
              Container(
                width: 40,
                height: 4,
                decoration: BoxDecoration(
                  color: Colors.grey.shade300,
                  borderRadius: BorderRadius.circular(999),
                ),
              ),
              const SizedBox(height: 12),
              Padding(
                padding: const EdgeInsets.symmetric(horizontal: 16),
                child: Row(
                  children: [
                    const Icon(Icons.folder_open, color: _mentorTeal),
                    const SizedBox(width: 8),
                    Expanded(
                      child: Text(
                        'Materials: ${widget.courseTitle}',
                        style: const TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.w700,
                        ),
                        overflow: TextOverflow.ellipsis,
                      ),
                    ),
                  ],
                ),
              ),
              const Divider(height: 20),
              Expanded(
                child: StreamBuilder<QuerySnapshot<Map<String, dynamic>>>(
                  stream: FirebaseFirestore.instance
                      .collection('course_materials')
                      .where('courseId', isEqualTo: widget.courseId)
                      .snapshots(),
                  builder: (context, snapshot) {
                    if (snapshot.connectionState == ConnectionState.waiting) {
                      return const Center(child: CircularProgressIndicator());
                    }

                    final docs = snapshot.data?.docs.toList() ?? [];
                    docs.sort((a, b) {
                      final aDate =
                          (a.data()['createdAt'] as Timestamp?)?.toDate() ??
                          DateTime.fromMillisecondsSinceEpoch(0);
                      final bDate =
                          (b.data()['createdAt'] as Timestamp?)?.toDate() ??
                          DateTime.fromMillisecondsSinceEpoch(0);
                      return bDate.compareTo(aDate);
                    });

                    if (docs.isEmpty) {
                      return const Center(
                        child: Padding(
                          padding: EdgeInsets.all(20),
                          child: Text(
                            'No materials uploaded yet.',
                            style: TextStyle(color: Colors.grey),
                          ),
                        ),
                      );
                    }

                    return ListView.separated(
                      controller: sc,
                      padding: const EdgeInsets.symmetric(horizontal: 16),
                      itemCount: docs.length,
                      separatorBuilder: (context, index) =>
                          const SizedBox(height: 10),
                      itemBuilder: (context, index) {
                        final doc = docs[index];
                        final data = doc.data();
                        final title =
                            (data['title'] as String?)?.trim().isNotEmpty ==
                                true
                            ? (data['title'] as String).trim()
                            : 'Untitled material';
                        final description =
                            (data['description'] as String?)?.trim() ?? '';
                        final resourceUrl =
                            (data['resourceUrl'] as String?)?.trim() ?? '';

                        return Card(
                          child: ListTile(
                            leading: const CircleAvatar(
                              backgroundColor: Color(0x1A0E7C86),
                              child: Icon(
                                Icons.article_outlined,
                                color: _mentorTeal,
                              ),
                            ),
                            title: Text(title),
                            subtitle: description.isEmpty
                                ? (resourceUrl.isEmpty
                                      ? null
                                      : Text(
                                          resourceUrl,
                                          maxLines: 1,
                                          overflow: TextOverflow.ellipsis,
                                        ))
                                : Text(
                                    description,
                                    maxLines: 2,
                                    overflow: TextOverflow.ellipsis,
                                  ),
                            trailing: IconButton(
                              icon: const Icon(
                                Icons.delete_outline,
                                color: Colors.red,
                              ),
                              onPressed: () =>
                                  _deleteMaterial(doc.id, resourceUrl),
                            ),
                          ),
                        );
                      },
                    );
                  },
                ),
              ),
              SafeArea(
                top: false,
                child: Padding(
                  padding: const EdgeInsets.fromLTRB(16, 12, 16, 16),
                  child: SizedBox(
                    width: double.infinity,
                    child: FilledButton.icon(
                      onPressed: _openUploadScreen,
                      icon: const Icon(Icons.add),
                      label: const Text('Add Material'),
                    ),
                  ),
                ),
              ),
            ],
          ),
        );
      },
    );
  }
}

